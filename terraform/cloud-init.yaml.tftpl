#cloud-config

hostname: ${jsonencode(vm_name)}
manage_etc_hosts: true

ssh_pwauth: false

users:
    - name: ${jsonencode(vm_user)}
      groups:
        - sudo
        - adm
      shell: /bin/bash
      sudo:
        - "ALL=(ALL) NOPASSWD:ALL"
      lock_passwd: true
      ssh_authorized_keys:
        - ${jsonencode(ssh_public_key)}

package_update: true

packages:
    - qemu-guest-agent

runcmd:
    - [systemctl, enable, --now, qemu-guest-agent]